@@ -518,6 +518,15 @@ def _build_config(params: dict, default_config: dict) -> dict:
     vendors = params.get("data_vendors") or {}
     if isinstance(vendors, dict) and vendors:
         cfg.setdefault("data_vendors", {}).update(vendors)
+    # --- TradingAgents-MOEX (spec §4): MOEX runs are routed through the
+    # MOEX vendors; non-MOEX configs are returned untouched.
+    if str(params.get("market") or "").upper() == "MOEX":
+        try:
+            from integration.config_adapter import enrich_run_config
+
+            cfg = enrich_run_config(params, cfg)
+        except Exception:  # extension absent → original behaviour preserved
+            pass
     return cfg
 
 
