+from pydantic import BaseModel, Field, field_validator
+
+_NUM_RE = re.compile(r"-?\d+(?:[.,]\d+)?")
+
+
+def _lenient_float(v):
+    """Coerce LLM-provided numeric fields without failing the whole call.
+
+    Free/edge models often return \"N/A\", \"~380 RUB\" or \"\" for optional
+    floats; a hard float parse then killed the structured invocation and
+    forced a free-text fallback (observed live on every run). Numbers pass
+    through, numeric strings are parsed best-effort, anything else → None.
+    """
+    if v is None or v == "":
+        return None
+    if isinstance(v, bool):
+        return None
+    if isinstance(v, (int, float)):
+        return float(v)
+    m = _NUM_RE.search(str(v).replace("−", "-"))
+    if not m:
+        return None
+    try:
+        return float(m.group(0).replace(",", "."))
+    except ValueError:
+        return None
 
 
