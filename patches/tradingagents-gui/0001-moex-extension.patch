+# --- TradingAgents-MOEX extension routes (spec §9). Optional: the GUI
+# keeps its original behaviour when the extension is not installed.
+try:
+    from integration.gui_routes import register_routes as _register_moex_routes
+
+    _register_moex_routes(app)
+except Exception as _moex_exc:  # pragma: no cover - extension optional
+    logging.getLogger(__name__).warning(
+        "MOEX extension routes not loaded: %s", _moex_exc
+    )
+
 
