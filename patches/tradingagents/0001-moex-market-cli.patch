diff --git a/cli/run.py b/cli/run.py
index 77bf955..e8bec9b 100644
--- a/cli/run.py
+++ b/cli/run.py
@@ -111,6 +111,25 @@ def run_analysis(checkpoint: bool | None = None, portfolio=None, flags=None):
 
     config = _build_run_config(selections, checkpoint)
 
+    # --- TradingAgents-MOEX (spec §4): route MOEX runs through the MOEX
+    # vendors. Non-MOEX runs keep the untouched original config.
+    if str(flags.get("market") or "").upper() == "MOEX":
+        try:
+            from integration.config_adapter import enrich_run_config
+            from integration.core_adapter import install as _install_moex_vendors
+
+            _install_moex_vendors()
+            config = enrich_run_config(
+                {
+                    "market": "MOEX",
+                    "ticker": flags.get("ticker") or selections.get("ticker") or "",
+                    "board": flags.get("board") or "",
+                },
+                config,
+            )
+        except Exception:  # extension absent → original behaviour preserved
+            pass
+
     stats_handler = StatsCallbackHandler()
 
